# Copy this file to `.env` and adjust the values for your environment.
#
#   PowerShell: Copy-Item .env.example .env
#   POSIX: cp .env.example .env

# Local PostgreSQL. Run `npm run db:secure` after npm install.
# The setup command generates separate random credentials and preserves the volume.
# POSTGRES_USER is the administration/migration role, never the application role.
POSTGRES_USER=safecheck
POSTGRES_PASSWORD=
POSTGRES_DB=safecheck
POSTGRES_PORT=5432
APP_DB_USER=safecheck_app
APP_DB_PASSWORD=

# Filled by `npm run db:secure`; do not commit real credentials.
# DATABASE_URL uses the restricted application role.
DATABASE_URL=
# Used by Prisma CLI for schema changes, not by the application Prisma client.
MIGRATION_DATABASE_URL=

# Fastify API (local development)
API_HOST=localhost
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# Required for signed guest cookies. Generate a random secret of at least 32 characters.
COOKIE_SECRET=

# Better Auth uses a separate random secret (at least 32 characters required)
# and runs on the Fastify API origin. Never reuse COOKIE_SECRET or DB passwords.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Optional: IPs/CIDRs of reverse proxies whose forwarding chain Fastify may use.
# Default is no trusted proxy; list only actual proxy socket addresses, e.g.
# API_TRUSTED_PROXIES=198.51.100.10,2001:db8::10/128
# CIDRs must be IPv4 /24-/32 or IPv6 /64-/128; mapped IPv6 is rejected.
# The trusted edge must overwrite incoming X-Forwarded-For with the actual client
# or append its observed client to the right of any incoming chain. Never forward
# an unverified client header unchanged. Configure each real trusted proxy hop.
# Constrain direct network access to the API when deployed behind a proxy.
# API_TRUSTED_PROXIES=

# Keep WEB_ORIGIN, BETTER_AUTH_URL and NEXT_PUBLIC_API_URL consistent with the
# actual browser origins. Restart the API and frontend after changing them.
# In production, WEB_ORIGIN and BETTER_AUTH_URL must be exact HTTPS origins;
# build the frontend with an HTTPS NEXT_PUBLIC_API_URL. HTTP localhost is for dev.
# These settings target two local Node processes plus PostgreSQL in Docker;
# the Compose app service runs Next only and does not start the Fastify API.
